# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API

# Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Publishable / Anon Key (Public)
# SAFE for client/browser use — protected by Row Level Security (RLS) in Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SECURITY REMINDER:
# - NEVER put the service_role key, database password, or secret keys here or in any NEXT_PUBLIC_* variable.
# - Keep your actual keys in .env.local (which is git-ignored and never pushed).
